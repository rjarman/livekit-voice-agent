; Generated at container start — do not edit in-container (use templates + rebuild)

[global]
type=global
user_agent=SipGateway-LiveKit-BDCOM
endpoint_identifier_order=ip,username,anonymous

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_media_address=${SERVER_IP_ADDRESS}
external_signaling_address=${SERVER_IP_ADDRESS}
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
external_media_address=${SERVER_IP_ADDRESS}
external_signaling_address=${SERVER_IP_ADDRESS}
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

; --- BDCOM (REGISTER + inbound identify) ---

[bdcom_auth]
type=auth
auth_type=userpass
username=${BDCOM_SIP_USER}
password=${BDCOM_SIP_PASSWORD}

[bdcom_aor]
type=aor
max_contacts=10
remove_existing=yes

[bdcom]
type=endpoint
transport=transport-udp
context=from-bdcom
disallow=all
allow=ulaw
allow=alaw
aors=bdcom_aor
outbound_auth=bdcom_auth
from_user=${BDCOM_SIP_USER}
from_domain=${BDCOM_SIP_REGISTRAR}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
timers=yes
rtp_timeout=120
rtp_keepalive=5

[bdcom_registration]
type=registration
transport=transport-udp
outbound_auth=bdcom_auth
server_uri=sip:${BDCOM_SIP_REGISTRAR}
client_uri=sip:${BDCOM_SIP_USER}@${BDCOM_SIP_REGISTRAR}
retry_interval=30
forbidden_retry_interval=600
expiration=3600
line=yes
endpoint=bdcom

[bdcom_identify]
type=identify
endpoint=bdcom
match=${BDCOM_IDENTIFY_MATCH}

; --- LiveKit SIP (second leg, Docker DNS) ---

[livekit_aor]
type=aor
contact=sip:${LIVEKIT_SIP_DID}@livekit-sip\;transport=udp
qualify_frequency=0

[livekit]
type=endpoint
transport=transport-udp
context=default
disallow=all
allow=ulaw
allow=alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
aors=livekit_aor
