# ===========================================
# CENTRAL ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in values
# ===========================================

# Server Configuration
SERVER_IP_ADDRESS=<server-ip-address or domain>

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_PASSWORD=<your-postgres-password>

# ===========================================
# n8n
# ===========================================
N8N_ENCRYPTION_KEY=<your-n8n-encryption-key>

# LiveKit Apple Seller Agent only: n8n webhooks (optional)
# Used by livekit-apple-seller-agent container. e.g. http://n8n:5678/webhook/purchase
N8N_PURCHASE_WEBHOOK_URL=
N8N_PRICES_WEBHOOK_URL=

# ===========================================
# LiveKit Server
# ===========================================
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>

# ===========================================
# LiveKit Dashboard
# https://github.com/thinhdanggroup/livekit-dashboard
# ===========================================
LIVEKIT_DASHBOARD_USERNAME=admin
LIVEKIT_DASHBOARD_PASSWORD=your-dashboard-password
LIVEKIT_DASHBOARD_SECRET_KEY=your-secret-key-for-sessions

# ===========================================
# LiveKit Agents - AI Service API Keys
# Shared by voice-agent and apple-seller-agent. Get free keys from:
# - AssemblyAI: https://www.assemblyai.com (100 hours free)
# - Groq: https://console.groq.com (free tier)
# - Cartesia: https://play.cartesia.ai (free tier)
# - Gemini: https://aistudio.google.com (free tier)
# - OpenAI: https://platform.openai.com/api-keys
# ===========================================
ASSEMBLYAI_API_KEY=<your-assemblyai-api-key>
GROQ_API_KEY=<your-groq-api-key>
CARTESIA_API_KEY=<your-cartesia-api-key>
GOOGLE_API_KEY=<your-google-api-key>
OPENAI_API_KEY=<your-openai-api-key>
# DashScope (Alibaba Cloud) — for Qwen-Omni-Realtime voice model (Singapore region)
# Get key at: https://dashscope-intl.console.aliyun.com/ → API Key
DASHSCOPE_API_KEY=<your-dashscope-api-key>

# ===========================================
# Voice Provider for Blocks Support Agent
# Options: "openai" (default), "local", "qwen"
# ===========================================
# "openai" — OpenAI Realtime (gpt-realtime-1.5, US servers, function calling works)
# "local"  — Local pipeline via custom_models server (STT+LLM+TTS on your Mac/GPU)
# "qwen"   — Qwen-Omni-Realtime via DashScope (Singapore, no function calling)
VOICE_PROVIDER=openai

# Local model server (only needed when VOICE_PROVIDER=local)
# Runs Bengali STT (Whisper), LLM (Qwen3-8B via Ollama), TTS (MMS Bengali)
# Access via SSH tunnel: ssh -R 0.0.0.0:8000:localhost:8000 user@server
# Use 172.17.0.1 (Docker bridge) so containers can reach the host's tunnel
LOCAL_MODEL_BASE_URL=http://172.17.0.1:8000/v1
LOCAL_MODEL_API_KEY=sk-local-bengali-2026
AZURE_LLM_ENDPOINT=<your-azure-llm-endpoint>
AZURE_LLM_API_KEY=<your-azure-llm-api-key>
AZURE_LLM_MODEL=gpt-4o-mini
AZURE_LLM_DEPLOYMENT=gpt-4o-mini
AZURE_LLM_API_VERSION=2025-01-01-preview

# Google Cloud credentials for Bengali agent STT + TTS (service account JSON file)
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable APIs: Cloud Speech-to-Text, Cloud Text-to-Speech
GOOGLE_APPLICATION_CREDENTIALS_FILE=./google-credentials.json

# ===========================================
# Qdrant Vector Database
# ===========================================
QDRANT_API_KEY=<your-qdrant-api-key>

# ===========================================
# Human Support Handoff (Blocks Support Agent)
# When the AI agent can't help, it calls this number to bring a human into the call.
# ===========================================
SUPPORT_PHONE_NUMBER=<support-agent-phone-number-e164>
SUPPORT_SIP_TRUNK_ID=<your-sip-outbound-trunk-id>

# ===========================================
# Twilio SIP (for LiveKit Telephony)
# Get credentials from: https://console.twilio.com
# ===========================================
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>

# ===========================================
# sip-gateway (BDCOM → Asterisk → LiveKit SIP)
# sip-gateway image uses Debian bullseye + apt asterisk (bookworm has no asterisk package)
#
# BDCOM portal mapping:
#   Domain            → BDCOM_SIP_REGISTRAR
#   Table "Number"    → BDCOM_SIP_USER (often 781580; if REGISTER fails, try 09666781580)
#   Secret            → BDCOM_SIP_PASSWORD (must be quoted if it contains $ — see below)
#   PSTN 09666781580  → LIVEKIT_SIP_DID as E.164 for LiveKit inbound trunk "numbers"
# ===========================================
BDCOM_SIP_REGISTRAR=119.40.82.1
BDCOM_SIP_USER=781580
BDCOM_SIP_PASSWORD=<your-bdcom-sip-secret>
# PJSIP identify: BDCOM domain / SBC (tighten if they give a distinct media IP range)
BDCOM_IDENTIFY_MATCH=119.40.82.1/32
# E.164 for 09666781580 → +8809666781580 (must match CreateSIPInboundTrunk "numbers")
LIVEKIT_SIP_DID=+8809666781580
# Must match docker-compose published RTP range for sip-gateway
SIP_GATEWAY_RTP_START=10000
SIP_GATEWAY_RTP_END=10100
